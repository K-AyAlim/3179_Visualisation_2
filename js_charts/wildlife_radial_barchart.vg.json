{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Impact of Pet and Feral Cats on Wildlife",
    "subtitle": "Each bar length represents the estimated number of animals killed in millions per year",
    "anchor": "start"
  },
  "width": 360,
  "height": 360,
  "padding": { "top": 20, "bottom": 20, "left": 24, "right": 24 },
  "data": { "url": "data_sources/wildlife_radial_barchart.csv" },
  "transform": [
    { "calculate": "1", "as": "slice" },
    {
      "calculate": "datum.animal_type + '\\n' + datum.label",
      "as": "wedge_label"
    }
  ],
  "encoding": {
    "theta": { "field": "slice", "type": "quantitative", "stack": true },
    "radius": {
      "field": "killed_millions",
      "type": "quantitative",
      "scale": { "type": "sqrt", "zero": true, "rangeMin": 20 }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 20,
        "stroke": "#ffffff",
        "strokeWidth": 3,
        "cornerRadius": 4
      },
      "encoding": {
        "color": { "value": "#b8476e" },
        "tooltip": [
          { "field": "animal_type", "type": "nominal", "title": "Animals" },
          {
            "field": "killed_millions",
            "type": "quantitative",
            "title": "Killed per year (millions)",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "radiusOffset": 30,
        "fontSize": 13,
        "fontWeight": "bold",
        "lineBreak": "\n"
      },
      "encoding": {
        "text": { "field": "wedge_label", "type": "nominal" },
        "color": { "value": "#7a5a50" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "font": "Nunito",
    "title": { "font": "Fraunces", "fontSize": 18, "subtitleColor": "#7a5a50" }
  }
}
