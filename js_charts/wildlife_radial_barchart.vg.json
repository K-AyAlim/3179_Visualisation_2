{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Impact of Pet and Feral Cats on Wildlife",
    "subtitle": "Each bar length represents the estimated number of animals killed in millions per year",
    "anchor": "start"
  },
  "width": 360,
  "height": 360,
  "padding": { "top": 20, "bottom": 20, "left": 24, "right": 24 },
  "data": { "url": "data_sources/wildlife_radial_barchart.csv" },
  "transform": [
    { "window": [{ "op": "row_number", "as": "rank" }] },
    { "calculate": "5 - datum.rank", "as": "ring_inner" },
    { "calculate": "datum.ring_inner + 0.75", "as": "ring_outer" },
    { "calculate": "datum.ring_inner + 0.375", "as": "ring_middle" },
    { "calculate": "0", "as": "start" },
    {
      "calculate": "datum.animal_type + ' · ' + datum.label",
      "as": "wedge_label"
    }
  ],
  "encoding": {
    "theta": {
      "field": "start",
      "type": "quantitative",
      "scale": { "domain": [0, 1400] }
    },
    "radius": {
      "field": "ring_middle",
      "type": "quantitative",
      "scale": { "domain": [0, 5] }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "arc",
        "stroke": "#ffffff",
        "strokeWidth": 3,
        "cornerRadius": 4
      },
      "encoding": {
        "theta2": { "field": "killed_millions" },
        "radius": { "field": "ring_outer" },
        "radius2": { "field": "ring_inner" },
        "color": {
          "field": "animal_type",
          "type": "nominal",
          "legend": null,
          "scale": { "range": ["#b8476e", "#d07a95", "#e3a1b6", "#5a3a2e"] }
        },
        "tooltip": [
          { "field": "animal_type", "type": "nominal", "title": "Animals" },
          {
            "field": "killed_millions",
            "type": "quantitative",
            "title": "Killed per year (millions)",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": { "field": "wedge_label", "type": "nominal" },
        "color": { "value": "#7a5a50" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "font": "Nunito",
    "title": { "font": "Fraunces", "fontSize": 18, "subtitleColor": "#7a5a50" }
  }
}
