{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Pets per Household",
    "subtitle": [
      "Each house = 2.5% of Australian households (rounded).",
      "Note one house can have more than one pet, so the percentages do not add up to 100."
    ],
    "anchor": "start"
  },
  "width": "container",
  "height": "container",
  "autosize": { "type": "fit", "contains": "padding" },
  "padding": { "top": 20, "bottom": 20, "left": 24, "right": 24 },

  "data": { "url": "data_sources/pictogram_pet_ownership.csv" },

  "transform": [
    { "calculate": "round(datum.household_penetration/2.5)", "as": "houses" },
    { "calculate": "sequence(0,25)", "as": "index" },
    { "flatten": ["index"] }
  ],

  "encoding": {
    "y": {
      "field": "pet_type",
      "type": "nominal",
      "title": null,
      "sort": ["Dogs", "Cats", "Fish", "Birds"],
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 14,
        "labelPadding": 24,
        "labelFont": "Fredoka",
        "labelFontWeight": 600
      }
    }
  },
  "layer": [
    {
      "transform": [{ "filter": "datum.index < datum.houses" }],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 300,
        "shape": "M0,-1 L1,-0.2 L0.7,-0.2 L0.7,1 L-0.7,1 L-0.7,-0.2 L-1,-0.2 Z"
      },
      "encoding": {
        "x": {
          "field": "index",
          "type": "quantitative",
          "axis": null,
          "scale": { "domain": [0, 22] }
        },
        "color": { "value": "#b8476e" },
        "tooltip": [
          { "field": "pet_type", "type": "nominal", "title": "Pet" },
          {
            "field": "household_penetration",
            "type": "quantitative",
            "title": "Share of households (%)"
          }
        ]
      }
    },
    {
      "transform": [{ "filter": "datum.index == datum.houses - 1" }],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 24,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": { "field": "index", "type": "quantitative" },
        "text": { "field": "label", "type": "nominal" },
        "color": { "value": "#3b2620" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "font": "Nunito",
    "title": { "font": "Fredoka", "fontSize": 18, "subtitleColor": "#7a5a50" }
  }
}
