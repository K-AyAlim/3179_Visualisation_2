{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {"text": "Pets per Household",
        "subtitle": "Each house = 5% of Australian households (rounded), 2025",
        "anchor": "start"},
        "width": "container",
        "height": 200,

    "data": {"url": "data_sources/pictogram_pet_ownership.csv"}, 
   
    "transform": [
    {"calculate": "round(datum.household_penetration/5)", "as": "houses"}, 
    {"calculate": "sequence(0,20)", "as": "index"}, 
    {"flatten":["index"]}],

    "encoding": { "y": {"field": "pet_type", "type": "nominal", "title": null, 
              "sort": ["Dogs", "Cats", "Fish", "Birds", "No pets"], 
             "axis": {"domain": false, "ticks": false, 
                      "labelFontSize": 14, "labelPadding": 24,
                      "labelFont": "Fraunces", "labelFontWeight": 600}}},
"layer": [
  {
      "mark": {"type": "point", "filled": true, "size": 300,"shape": "M0,-1 L1,-0.2 L0.7,-0.2 L0.7,1 L-0.7,1 L-0.7,-0.2 L-1,-0.2 Z" },     "encoding": {
      "x": {"field": "index", "type": "quantitative", "axis": null},
      "color": {"condition": [
                  {"test": "datum.index < datum.houses && datum.pet_type == 'Cats'", "value": "#d9772b"},
                  {"test": "datum.index < datum.houses", "value": "#4a3a30"}],
                "value": "#e0d3c5"},
      "tooltip": [
        {"field": "pet_type", "type": "nominal", "title": "Pet"},
        {"field": "household_penetration", "type": "quantitative", "title": "Share of households (%)"}
      ]
    }
  },
  {
    "transform": [{"filter": "datum.index == 19"}],
    "mark": {"type": "text", "align": "left", "dx": 14, "fontSize": 13, "fontWeight": "bold"},
    "encoding": {
      "x": {"field": "index", "type": "quantitative"},
      "text": {"field": "household_penetration", "type": "quantitative", "format": ".1f"},
      "color": {
        "condition": {"test": "datum.pet_type == 'Cats'", "value": "#d9772b"},
        "value": "#6b5a4e"
      }
    }
  }
],
"config": {
  "view": {"stroke": null},
  "font": "Nunito",
  "title": {"font": "Fraunces", "fontSize": 18, "subtitleColor": "#6b5a4e"}
}
}