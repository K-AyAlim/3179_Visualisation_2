{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Comparison of Adoption Wait Times Based on Age",
    "subtitle": "Share of Cats that Took More than 60 Days to be Adopted",
    "anchor": "start"
  },
  "width": "container",
  "height": "container",
  "autosize": { "type": "fit", "contains": "padding" },
  "padding": { "top": 20, "bottom": 20, "left": 24, "right": 24 },
  "data": { "url": "data_sources/adoption_barchart.csv" },
  "encoding": {
    "x": {
      "field": "cat_type",
      "type": "nominal",
      "title": null,
      "sort": ["Kittens", "Adolescent & adult cats"],
      "axis": {
        "labelAngle": 0,
        "ticks": false,
        "labelFontSize": 14,
        "labelPadding": 12,
        "labelFont": "Fredoka",
        "labelFontWeight": 600
      }
    },
    "y": {
      "field": "percent_over_60_days",
      "type": "quantitative",
      "title": "Cats waiting over 60 days",
      "scale": { "domain": [0, 25] },
      "axis": {
        "tickCount": 5,
        "labelExpr": "datum.label + '%'",
        "titleFont": "Fredoka",
        "titleFontSize": 13,
        "titlePadding": 12
      }
    }
  },
  "layer": [
    {
      "mark": { "type": "bar", "cornerRadiusEnd": 4, "width": { "band": 0.6 } },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.cat_type == 'Adolescent & adult cats'",
            "value": "#b8476e"
          },
          "value": "#5a3a2e"
        },
        "tooltip": [
          { "field": "cat_type", "type": "nominal", "title": "Cats" },
          {
            "field": "percent_over_60_days",
            "type": "quantitative",
            "title": "Waited 60+ days (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -8,
        "fontSize": 14,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": { "field": "label", "type": "nominal" },
        "color": {
          "condition": {
            "test": "datum.cat_type == 'Adolescent & adult cats'",
            "value": "#b8476e"
          },
          "value": "#7a5a50"
        }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "font": "Nunito",
    "title": { "font": "Fredoka", "fontSize": 18, "subtitleColor": "#7a5a50" }
  }
}
