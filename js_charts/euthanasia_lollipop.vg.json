{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Most cats are euthanised for medical or behavioural reasons",
    "subtitle": "Cats euthanised by the RSPCA in 2023–24, by reason (5,148 in total)",
    "anchor": "start"
  },
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "top": 20,
    "bottom": 20,
    "left": 24,
    "right": 24
  },
  "data": {
    "url": "data_sources/euthanasia_reasons.csv"
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "Number_Euthanised",
          "as": "total"
        }
      ]
    },
    {
      "calculate": "datum.Number_Euthanised / datum.total",
      "as": "share"
    },
    {
      "calculate": "format(datum.Number_Euthanised, ',')",
      "as": "label"
    }
  ],
  "encoding": {
    "y": {
      "field": "Number_Euthanised",
      "type": "quantitative",
      "title": "Cats euthanised",
      "scale": {
        "domain": [
          0,
          2500
        ]
      },
      "axis": {
        "format": ",.0f",
        "tickCount": 5,
        "titleFont": "Fredoka",
        "titleFontSize": 13,
        "titlePadding": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#b8476e"
      },
      "encoding": {
        "x": {
          "field": "Reason",
          "type": "nominal",
          "title": "Reason for euthanasia",
          "sort": [
            "Medical",
            "Behavioural",
            "Infectious",
            "Other"
          ],
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 14,
            "labelPadding": 10,
            "labelFont": "Fredoka",
            "labelFontWeight": 600,
            "titleFont": "Fredoka",
            "titleFontSize": 13,
            "titlePadding": 12
          }
        },
        "y2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 300,
        "opacity": 1,
        "color": "#b8476e"
      },
      "encoding": {
        "x": {
          "field": "Reason",
          "type": "nominal",
          "sort": [
            "Medical",
            "Behavioural",
            "Infectious",
            "Other"
          ]
        },
        "tooltip": [
          {
            "field": "Reason",
            "type": "nominal",
            "title": "Reason"
          },
          {
            "field": "Number_Euthanised",
            "type": "quantitative",
            "title": "Cats euthanised",
            "format": ","
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of all cats euthanised",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -14,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#3b2620"
      },
      "encoding": {
        "x": {
          "field": "Reason",
          "type": "nominal",
          "sort": [
            "Medical",
            "Behavioural",
            "Infectious",
            "Other"
          ]
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Nunito",
    "title": {
      "font": "Fredoka",
      "fontSize": 18,
      "subtitleColor": "#7a5a50"
    }
  }
}
