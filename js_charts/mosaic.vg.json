{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Desexing rates",
    "subtitle": "by breed type and age",
    "anchor": "start"
  },
  "width": "container",
  "height": "container",
  "autosize": { "type": "fit", "contains": "padding" },
  "padding": { "top": 20, "bottom": 20, "left": 24, "right": 24 },
  "data": { "url": "data_sources/mosaic_desexing.csv" },
  "transform": [
    {
      "calculate": "indexof(['By 4 months', '4 to 6 months', '6 to 12 months', '1 to 2 years', 'Over 2 years'], datum.age_band)",
      "as": "order"
    },
    { "calculate": "datum.percent / 100", "as": "share" }
  ],
  "encoding": {
    "x": {
      "field": "breed_group",
      "type": "nominal",
      "title": null,
      "sort": ["Mixed breed", "Purebred"],
      "axis": {
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "labelFontSize": 14,
        "labelFont": "Fredoka",
        "labelFontWeight": 600,
        "labelPadding": 10
      }
    },
    "order": { "field": "order" }
  },
  "layer": [
    {
      "mark": { "type": "bar", "stroke": "#ffffff", "strokeWidth": 2 },
      "encoding": {
        "y": {
          "field": "percent",
          "type": "quantitative",
          "stack": "normalize",
          "title": null,
          "axis": {
            "format": ".0%",
            "domain": false,
            "ticks": false,
            "tickCount": 5
          }
        },
        "color": {
          "field": "age_band",
          "type": "nominal",
          "title": "Age at desexing",
          "scale": {
            "domain": [
              "By 4 months",
              "4 to 6 months",
              "6 to 12 months",
              "1 to 2 years",
              "Over 2 years"
            ],
            "range": ["#b8476e", "#8a6d9e", "#4f8fa8", "#6fa56b", "#e0a03c"]
          },
          "legend": {
            "orient": "right",
            "labelFontSize": 13,
            "symbolType": "square",
            "symbolSize": 200
          }
        },
        "tooltip": [
          { "field": "breed_group", "type": "nominal", "title": "Breed group" },
          {
            "field": "age_band",
            "type": "nominal",
            "title": "Age at desexing"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of desexed cats",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "mark": { "type": "text", "fontSize": 13, "fontWeight": "bold" },
      "encoding": {
        "y": {
          "field": "percent",
          "type": "quantitative",
          "stack": "normalize",
          "bandPosition": 0.5
        },
        "text": { "field": "share", "type": "quantitative", "format": ".0%" },
        "detail": { "field": "age_band" },
        "color": {
          "condition": { "test": "datum.order <= 2", "value": "#ffffff" },
          "value": "#3b2620"
        }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "font": "Nunito",
    "title": { "font": "Fredoka", "fontSize": 18, "subtitleColor": "#7a5a50" }
  }
}
