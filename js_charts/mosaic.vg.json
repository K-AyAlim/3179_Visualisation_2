{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Unknown-breed cats are rarely desexed",
    "subtitle": "Share of registered cats in each breed group that are desexed (Townsville and Golden Plains)",
    "anchor": "start"
  },
  "width": "container",
  "height": 320,
  "autosize": { "type": "fit", "contains": "padding" },
  "padding": { "top": 20, "bottom": 20, "left": 24, "right": 24 },
  "data": { "url": "data_sources/mosaic_desexing.csv" },
  "transform": [
    {
      "joinaggregate": [{ "op": "sum", "field": "cats", "as": "group_total" }],
      "groupby": ["breed_group"]
    },
    { "calculate": "datum.cats / datum.group_total", "as": "share" },
    { "calculate": "indexof(['Not desexed', 'Desexed'], datum.status)", "as": "order" }
  ],
  "encoding": {
    "x": {
      "field": "breed_group",
      "type": "nominal",
      "title": null,
      "sort": ["Mixed", "Crossbred", "Purebred", "Unknown"],
      "axis": {
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "labelFontSize": 14,
        "labelFont": "Fredoka",
        "labelFontWeight": 600,
        "labelPadding": 10
      }
    },
    "order": { "field": "order" }
  },
  "layer": [
    {
      "mark": { "type": "bar", "stroke": "#ffffff", "strokeWidth": 2 },
      "encoding": {
        "y": {
          "field": "cats",
          "type": "quantitative",
          "stack": "normalize",
          "title": null,
          "axis": { "format": ".0%", "domain": false, "ticks": false, "tickCount": 5 }
        },
        "color": {
          "field": "status",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": ["Not desexed", "Desexed"],
            "range": ["#b8476e", "#ead2d4"]
          },
          "legend": { "orient": "bottom", "labelFontSize": 13 }
        },
        "tooltip": [
          { "field": "breed_group", "type": "nominal", "title": "Breed group" },
          { "field": "status", "type": "nominal", "title": "Status" },
          { "field": "cats", "type": "quantitative", "title": "Cats", "format": "," },
          { "field": "share", "type": "quantitative", "title": "Share of group", "format": ".1%" },
          { "field": "group_total", "type": "quantitative", "title": "Cats in group", "format": "," }
        ]
      }
    },
    {
      "mark": { "type": "text", "fontSize": 13, "fontWeight": "bold" },
      "encoding": {
        "y": {
          "field": "cats",
          "type": "quantitative",
          "stack": "normalize",
          "bandPosition": 0.5
        },
        "text": { "field": "share", "type": "quantitative", "format": ".0%" },
        "detail": { "field": "status" },
        "color": {
          "condition": { "test": "datum.status == 'Not desexed'", "value": "#ffffff" },
          "value": "#3b2620"
        }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "font": "Nunito",
    "title": { "font": "Fredoka", "fontSize": 18, "subtitleColor": "#7a5a50" }
  }
}
